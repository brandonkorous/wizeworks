link-workspace-packages=true
prefer-workspace-packages=true
auto-install-peers=true
strict-peer-dependencies=false

# Tailwind resolves `@plugin '@wizeworks/silicaui'` in app/globals.css from the
# workspace root, not from the app, so the family has to be hoisted to where it
# can be found.
public-hoist-pattern[]=*silicaui*
